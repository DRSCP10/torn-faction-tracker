# Faction API key (server only) — enable Faction API Access in Torn key settings
TORN_API_KEY=

# Signs member/admin session cookies (required)
SESSION_SECRET=change-me-to-a-long-random-string

# Officer password for /admin.html access management
ADMIN_PASSWORD=

# Optional: commit allowlist changes from Vercel admin panel
GITHUB_ACCESS_TOKEN=
GITHUB_OWNER=bnc2022mf
GITHUB_REPO=torn-faction-tracker

# Or static allowlist JSON when not using data/access.json
# ACCESS_ALLOWLIST={"version":1,"users":[{"id":"345343","name":"Dwayne"}]}

# Discord bot (run separately: npm run bot)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

APP_URL=https://your-app.vercel.app
BOT_API_SECRET=

DISCORD_WEBHOOK_URL=
