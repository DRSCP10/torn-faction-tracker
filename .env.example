# Faction API key (server only) — enable Faction API Access in Torn key settings
TORN_API_KEY=

# Signs member/admin session cookies (required)
SESSION_SECRET=change-me-to-a-long-random-string

# Officer password for /admin.html (optional if set via Admin → Secrets)
ADMIN_PASSWORD=

# Optional: separate key for encrypting secrets in data/settings.json
# SETTINGS_ENCRYPTION_KEY=

# Recommended on Vercel: Storage → Postgres (Neon). Auto-set on Vercel as POSTGRES_URL.
# POSTGRES_URL=

# Optional: Upstash Redis / Vercel KV instead of Postgres
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Alternative: repo write token — commits allowlist + settings to GitHub
GITHUB_ACCESS_TOKEN=
GITHUB_OWNER=bnc2022mf
GITHUB_REPO=torn-faction-tracker

# Or static allowlist JSON when not using data/access.json
# ACCESS_ALLOWLIST={"version":1,"users":[{"id":"345343","name":"Dwayne"}]}

# Discord bot (run separately: npm run bot)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Discord bot → deployed API (optional if set in Admin → App settings / Secrets)
APP_URL=https://your-app.vercel.app
BOT_API_SECRET=

DISCORD_WEBHOOK_URL=
