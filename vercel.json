{
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/hits-today", "destination": "/hits-today.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
