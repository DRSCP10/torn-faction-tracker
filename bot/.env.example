# Discord (required)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Guild ID = instant slash command updates (recommended on Pi)
DISCORD_GUILD_ID=

# ── Raspberry Pi recommended: local mode ─────────────────────────────
# Faction API key with Faction API Access (attacks, basic, upgrades)
TORN_API_KEY=

# Optional: war window without Admin UI (unix seconds, TCT/UTC)
# WAR_STARTED_AT=1749016800
# WAR_LABEL=Ranked war
# INACTIVE_AFTER_HOURS=2

# Repo root if systemd WorkingDirectory differs (usually not needed)
# REPO_ROOT=/home/pi/torn-faction-tracker

# ── Alternative: remote mode (Vercel dashboard as API) ───────────────
# APP_URL=https://your-app.vercel.app
# BOT_API_SECRET=long-random-secret-matching-vercel-admin
# BOT_FORCE_REMOTE=1

# Link shown in embeds (optional in remote mode; uses APP_URL)
# DASHBOARD_URL=https://your-app.vercel.app
